{
	"mcpServers": {
		"anthropic-resources": {
			"type": "http",
			"url": "https://resources.anthropic.com/mcp"
		},
		"ast-grep": {
			"type": "stdio",
			"command": "bunx",
			"args": ["-y", "@notprolands/ast-grep-mcp"]
		},
		"code-sandbox": {
			"type": "stdio",
			"command": "bunx",
			"args": ["-y", "node-code-sandbox-mcp"]
		},
		"context7": {
			"type": "http",
			"url": "https://mcp.context7.com/mcp"
		},
		"django": {
			"type": "stdio",
			"command": "bunx",
			"args": ["-y", "django-mcp"],
			"env": {
				"DJANGO_SETTINGS_MODULE": "projects.ecom.backend.config.settings"
			}
		},
		"evals": {
			"type": "stdio",
			"command": "bunx",
			"args": ["-y", "@modelcontextprotocol/server-evals"]
		},
		"everart": {
			"type": "http",
			"url": "https://mcp.everart.ai/mcp"
		},
		"fetch": {
			"type": "stdio",
			"command": "bunx",
			"args": ["-y", "mcp-server-fetch-typescript"]
		},
		"filesystem": {
			"type": "stdio",
			"command": "bunx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-filesystem",
				"C:/Users/Alexa",
				"C:/Users/Alexa/AppData/Local/hermes",
				"${workspaceFolder}"
			]
		},
		"github": {
			"type": "stdio",
			"command": "bunx",
			"args": ["-y", "@modelcontextprotocol/server-github"],
			"env": {
				"GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_TOKEN}"
			}
		},
		"honcho": {
			"type": "http",
			"url": "https://mcp.honcho.dev/"
		},
		"mcp-docker": {
			"type": "stdio",
			"command": "docker",
			"args": ["mcp", "gateway", "run", "--profile", "adminbot"]
		},
