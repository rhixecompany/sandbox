		"MCP_CONTEXT7": {
			"type": "http",
			"enabled": true,
			"command": null,
			"args": null,
			"url": "https://mcp.context7.com/mcp",
			"env": {}
		},
		"MCP_FETCH": {
			"type": "stdio",
			"enabled": true,
			"command": "bunx",
