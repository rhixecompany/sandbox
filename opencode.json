			"env": {}
		},
		"MCP_FILESYSTEM": {
			"type": "stdio",
			"enabled": true,
			"command": "bunx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-filesystem",
				"C:/Users/Alexa",
				"C:/Users/Alexa/AppData/Local/hermes",
