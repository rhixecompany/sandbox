{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"ast-grep": {
			"command": [
				"bunx",
				"-y",
				"@notprolands/ast-grep-mcp"
			],
			"enabled": true,
			"type": "local"
		},
		"CODE-SANDBOX": {
			"command": [
				"bunx",
				"-y",
				"node-code-sandbox-mcp"
			],
			"enabled": true,
			"type": "local"
		},
		"CONTEXT7": {
			"enabled": true,
			"type": "remote",
			"url": "https://mcp.context7.com/mcp"
		},
		"DJANGO": {
			"command": [
				"bunx",
				"-y",
				"django-mcp"
			],
			"enabled": true,
			"type": "local"
		},
		"DOCS": {
			"command": [
				"bunx",
				"-y",
				"docs-mcp",
				"docs/"
			],
			"enabled": true,
			"type": "local"
		},
		"FETCH": {
			"command": [
				"bunx",
				"-y",
				"mcp-server-fetch-typescript"
			],
			"enabled": true,
			"type": "local"
		},
		"FILESYSTEM": {
			"command": [
				"bunx",
				"-y",
				"@modelcontextprotocol/server-filesystem",
				"C:/Users/Alexa",
				"C:/Users/Alexa/AppData/Local/hermes",
				"${workspaceFolder}"
			],
			"enabled": true,
			"type": "local"
		},
		"GITHUB": {
			"command": [
				"bunx",
				"-y",
				"@modelcontextprotocol/server-github"
			],
			"enabled": true,
			"type": "local"
		},
		"HONCHO": {
			"enabled": true,
			"type": "remote",
			"url": "https://mcp.honcho.dev/"
		},
		"MCP-DOCKER": {
			"command": [
				"docker",
				"mcp",
				"gateway",
				"run",
				"--profile",
				"adminbot"
			],
			"enabled": true,
			"type": "local"
		},
		"MEMORY": {
			"command": [
				"bunx",
				"-y",
				"@modelcontextprotocol/server-memory"
			],
			"enabled": true,
			"type": "local"
		},
		"MINDSTUDIO": {
			"command": [
				"C:\\Users\\Alexa\\.mindstudio\\bin\\mindstudio.exe",
				"mcp"
			],
			"enabled": true,
			"type": "local"
		},
		"NEON": {
			"enabled": true,
			"type": "remote",
			"url": "https://mcp.neon.tech/mcp"
		},
		"PARALLEL-SEARCH": {
			"enabled": true,
			"type": "remote",
			"url": "https://search.parallel.ai/mcp"
		},
		"PARALLEL-TASK": {
			"enabled": true,
			"type": "remote",
			"url": "https://task-mcp.parallel.ai/mcp"
		},
		"PLAYWRIGHT": {
			"command": [
				"bunx",
				"-y",
				"@playwright/mcp@0.0.78"
			],
			"enabled": true,
			"type": "local"
		},
		"POSTGRES": {
			"command": [
				"bunx",
				"-y",
				"postgres-mcp"
			],
			"enabled": true,
			"type": "local"
		},
		"PYTEST": {
			"command": [
				"bunx",
				"-y",
				"pytest-mcp"
			],
			"enabled": true,
			"type": "local"
		},
		"PYTHON-QUALITY": {
			"command": [
				"C:\\Users\\Alexa\\AppData\\Local\\hermes\\hermes-agent\\venv\\Scripts\\python.exe",
				"C:\\Users\\Alexa\\AppData\\Local\\hermes\\scripts\\python_quality_server.py"
			],
			"enabled": true,
			"type": "local"
		},
		"SENTRY": {
			"enabled": true,
			"type": "remote",
			"url": "https://mcp.sentry.dev/mcp"
		},
		"SEQUENTIAL-THINKING": {
			"command": [
				"bunx",
				"-y",
				"@modelcontextprotocol/server-sequential-thinking"
			],
			"enabled": true,
			"type": "local"
		},
		"SMITHERY": {
			"enabled": true,
			"type": "remote",
			"url": "https://mcp.smithery.ai/alexanderrhixe30"
		},
		"TAVILY": {
			"enabled": true,
			"type": "remote",
			"url": "https://mcp.tavily.com/mcp/?tavilyApiKey=${env:TAVILY_API_KEY}"
		},
		"TOOLING-CONFIG": {
			"command": [
				"C:\\Users\\Alexa\\AppData\\Local\\hermes\\hermes-agent\\venv\\Scripts\\python.exe",
				"C:\\Users\\Alexa\\AppData\\Local\\hermes\\scripts\\tooling_config_server.py"
			],
			"enabled": true,
			"type": "local"
		},
		"TOOLING-LINT": {
			"command": [
				"C:\\Users\\Alexa\\AppData\\Local\\hermes\\hermes-agent\\venv\\Scripts\\python.exe",
				"C:\\Users\\Alexa\\AppData\\Local\\hermes\\scripts\\tooling_lint_server.py"
			],
			"enabled": true,
			"type": "local"
		}
	},
	"model": "opencode/nemotron-3-ultra-free",
	"plugin": [
		"oh-my-openagent@latest"
	],
	"small_model": "opencode/nemotron-3-ultra-free"
}
