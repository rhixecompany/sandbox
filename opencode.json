{
	"$schema": "https://opencode.ai/config.json",
	"model": "opencode/deepseek-v4-flash-free",
	"small_model": "opencode/deepseek-v4-flash-free",
	"plugin": ["oh-my-openagent@latest"],
	"mcp": {
		"MCP_AST-GREP": {
			"type": "stdio",
			"enabled": true,
			"command": "bunx",
			"args": ["-y", "@notprolands/ast-grep-mcp"],
