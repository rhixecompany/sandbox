// Flat markdownlint ruleset for legacy consumers (VS Code extension, markdownlint-cli).
// markdownlint-cli2 uses .markdownlint-cli2.jsonc — keep rules in sync.
{
	// Structure
	"MD001": false,
	"MD002": false,
	"MD003": false,
	"MD018": false,
	"MD019": false,
	"MD025": false,
	// Lists
	"MD004": false,
	"MD005": false,
	"MD007": { "indent": 2 },
	"MD029": false,
	"MD030": false,
	"MD032": true,
	// Code/fences
	"MD010": { "code_blocks": false },
	"MD040": false,
	"MD013": false,
	"MD038": false,
	"MD046": true,
	// Links/images
	"MD011": false,
	"MD034": false,
	"MD039": false,
	"MD033": false,
	"MD042": false,
	"MD045": false,
	"MD048": true,
	// Tables
	"MD060": true,
	// Line length/spacing
	"MD009": false,
	"MD012": false,
	"MD013": false,
	"MD022": true,
	"MD023": true,
	"MD026": false,
	"MD027": false,
	"MD028": false,
	"MD031": true,
	"MD036": false,
	"MD047": true,
	"MD059": false,
}
