{
	"version": "2.0.0",
	"options": {
		"cwd": "${workspaceFolder}"
	},
	"tasks": [
		{
			"command": "python -m pytest",
			"label": "Python: Test All",
			"type": "shell",
			"group": "test",
			"problemMatcher": "$python.pytest",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"command": "ruff check .",
			"label": "Python: Lint (ruff)",
			"type": "shell",
			"group": "build",
			"problemMatcher": "$ruff",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"command": "ruff format .",
			"label": "Python: Format (ruff)",
			"type": "shell",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"command": "mypy .",
			"label": "Python: Typecheck (mypy)",
			"type": "shell",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"command": "eslint .",
			"label": "JS/TS: Lint (eslint)",
			"type": "shell",
			"group": "build",
			"problemMatcher": "$eslint-stylish",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"command": "prettier --check .",
			"label": "Format: Check (prettier)",
			"type": "shell",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"command": "markdownlint-cli2 --config .markdownlint-cli2.jsonc \"**/*.md\"",
			"label": "Docs: Lint (markdownlint)",
			"type": "shell",
			"group": "build",
			"problemMatcher": {
				"owner": "markdownlint-cli2",
				"fileLocation": ["relative", "${workspaceFolder}"],
				"pattern": {
					"regexp": "^(.*):(\\\\d+):(\\\\d+)\\\\s+(MD\\\\w+)\\\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"code": 4,
					"message": 5
				}
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"command": "cspell lint \"**/*\"",
			"label": "Spell: Check (cspell)",
			"type": "shell",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"command": "tsc --noEmit",
			"label": "TS: Typecheck (tsc)",
			"type": "shell",
			"group": "build",
			"problemMatcher": "$tsc",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"command": "bun test",
			"label": "Bun: Test All",
			"type": "shell",
			"group": "test",
			"problemMatcher": "$bun-test",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"command": "bun run lint",
			"label": "Bun: Lint",
			"type": "shell",
			"group": "build",
			"problemMatcher": "$eslint-stylish",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"command": "go test ./...",
			"label": "Go: Test All",
			"type": "shell",
			"group": "test",
			"problemMatcher": "$go-test",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"command": "dotnet build",
			"label": "C#: Build",
			"type": "shell",
			"group": "build",
			"problemMatcher": "$msCompile",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"command": "dotnet test",
			"label": "C#: Test",
			"type": "shell",
			"group": "test",
			"problemMatcher": "$xunit",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"command": "java -jar",
			"label": "Java: Run",
			"type": "shell",
			"group": "build",
			"problemMatcher": "$java",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"command": "pytest",
			"label": "Python: Debug Test",
			"type": "shell",
			"group": "test",
			"problemMatcher": "$python.pytest",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		}
	]
}
