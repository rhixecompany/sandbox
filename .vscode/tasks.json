{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "lint",
            "type": "shell",
            "command": "bun run lint",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$eslint-stylish"
            ]
        },
        {
            "label": "typecheck",
            "type": "shell",
            "command": "bun run typecheck",
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "check",
            "type": "shell",
            "command": "bun run check",
            "group": {
                "kind": "test",
                "isDefault": false
            }
        }
    ]
}