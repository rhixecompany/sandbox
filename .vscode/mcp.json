{
	"inputs": [
		{
			"type": "promptString",
			"id": "workspaceFolder",
			"description": "Workspace root path",
			"default": "${workspaceFolder}"
		}
	],
	"servers": {
		"filesystem": {
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-filesystem", "${workspaceFolder}"]
		}
	}
}
