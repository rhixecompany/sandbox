{
	"$schema": "https://json.schemastore.org/mcp.json",
	"mcpServers": {
		"ast-grep": {
			"command": "npx",
			"args": ["-y", "@notprolands/ast-grep-mcp"]
		},
		"code-sandbox": {
			"command": "npx",
			"args": ["-y", "node-code-sandbox-mcp"]
		},
		"fetch": {
			"command": "npx",
			"args": ["-y", "mcp-server-fetch-typescript"]
		},
		"filesystem": {
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-filesystem", "C:/Users/Alexa", "C:/Users/Alexa/AppData/Local/hermes"]
		},
		"github": {
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-github"],
			"env": {
				"GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_TOKEN}"
			}
		},
		"mcp-docker": {
			"command": "docker",
			"args": ["mcp", "gateway", "run", "--profile", "adminbot"]
		},
		"memory": {
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-memory"]
		},
		"playwright": {
			"command": "npx",
			"args": ["-y", "@playwright/mcp@latest"]
		},
		"sequential-thinking": {
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
		},
		"neon": {
			"type": "http",
			"url": "https://mcp.neon.tech/mcp"
		},
		"context7": {
			"type": "http",
			"url": "https://mcp.context7.com/mcp"
		},
		"sentry": {
			"type": "http",
			"url": "https://mcp.sentry.dev/mcp"
		},
		"tavily": {
			"type": "http",
			"url": "https://mcp.tavily.com/mcp/?tavilyApiKey=${env:TAVILY_API_KEY}"
		}
	}
}
