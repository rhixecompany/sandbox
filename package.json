{
	"name": "sandbox",
	"type": "module",
	"private": true,
	"scripts": {
		"lint": "eslint . --no-error-on-unmatched-pattern",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check --ignore-unknown .",
		"markdownlint": "markdownlint-cli2 --config .markdownlint.jsonc \"**/*.md\"",
		"spellcheck": "cspell lint \"**/*.{ts,tsx,js,jsx,mjs,json,jsonc,yaml,yml,toml,py,sh}\" --no-progress",
		"typecheck": "tsc --noEmit",
		"check": "bun run lint && bun run format:check && bun run markdownlint && bun run spellcheck"
	},
	"devDependencies": {
		"@eslint-react/eslint-plugin": "^5.19.0",
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^10.0.1",
		"@next/eslint-plugin-next": "^16.3.4",
		"@types/bun": "latest",
		"@types/node": "^24.0.0",
		"cspell": "^10.0.1",
		"eslint": "^10.0.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-better-tailwindcss": "^4.7.0",
		"eslint-plugin-drizzle": "^0.2.3",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-jest": "^29.16.6",
		"eslint-plugin-jsdoc": "^64.3.9",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-n": "^18.3.0",
		"eslint-plugin-no-secrets": "^2.3.3",
		"eslint-plugin-perfectionist": "^5.11.0",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-react-refresh": "^0.5.6",
		"eslint-plugin-regexp": "^3.3.0",
		"eslint-plugin-security": "^4.0.1",
		"eslint-plugin-sonarjs": "^4.2.0",
		"eslint-plugin-testing-library": "^7.16.2",
		"eslint-plugin-unicorn": "^74.0.0",
		"eslint-plugin-zod": "^4.12.0",
		"globals": "^17.8.0",
		"markdownlint-cli2": "^0.19.1",
		"next": "^16.3.4",
		"prettier": "^3.9.6",
		"typescript": "^5.9.0",
		"typescript-eslint": "^8.65.0"
	},
	"packageManager": "bun@1.3.14",
	"dependencies": {
		"@swc/helpers": "^0.5.23"
	}
}
